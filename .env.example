# ===================================================
# INDICLIVE ROOT ENVIRONMENT CONFIGURATION
# ===================================================

# --- Backend Configuration ---
# Sarvam AI API Key (Leave blank to use Demo Mode, or paste your API key for live AI)
SARVAM_API_KEY=

# Sarvam Model Identifiers
SARVAM_STT_MODEL=saaras:v4
SARVAM_TRANSLATION_MODEL=sarvam-translate:v1
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_CONVERSATIONAL_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v3

# Runtime Modes
DEMO_MODE=true
ENABLE_TTS=false
LLM_ENABLED=false
LLM_MODE=balanced

# Language Configuration
ENABLE_AUTO_LANGUAGE_DETECTION=true
DEFAULT_SOURCE_LANGUAGE=en-IN
DEFAULT_TARGET_LANGUAGES=ta-IN,hi-IN,ml-IN

# Commit Policy & Streaming Intelligence
MAX_CONTEXT_SEGMENTS=5
MIN_TRANSLATION_TOKENS=3
MAX_PARTIAL_WAIT_MS=1200
SILENCE_COMMIT_MS=450
STABILITY_THRESHOLD=0.80

# Timeouts & Guardrails (seconds)
TRANSLATION_TIMEOUT=5
LLM_TIMEOUT=4
TTS_TIMEOUT=8
MAX_LLM_CALLS_PER_SEGMENT=1

# Storage & Network
DATABASE_URL=sqlite+aiosqlite:///./indiclive.db
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
